{
    "cli": {
        "version": ">= 3.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development"
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://recashly.dadi.web.id/api"
            },
            "android": {
                "buildType": "apk",
                "image": "latest"
            },
            "ios": {
                "simulator": false
            }
        },
        "production": {
            "channel": "production",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://recashly.dadi.web.id/api"
            },
            "android": {
                "buildType": "apk",
                "image": "latest"
            }
        }
    },
    "submit": {
        "production": {}
    }
}